# Optional startup defaults. Use /configure to manage settings in a browser.
# Use Share addon in Stremio to copy the install link for an add-on that supplies playable streams.
STREAM_ADDON_MANIFEST=
# Optional. Paste the install link for a second stream add-on.
STREAM_ADDON_MANIFEST_2=
# Get your key in the API section of your SubDL account panel.
SUBDL_API_KEY=
# Get an API key from https://www.opensubtitles.com/en/consumers.
OPENSUBTITLES_API_KEY=
# Get an API key under API & Plans in your SubSource account dashboard.
SUBSOURCE_API_KEY=

# Comma-separated subtitle language codes to match (default: all supported).
# Supported: el, en, es, pt, fr, de, it, pl, ru, tr, ar, ro
# LANGUAGES=el,en

# Defaults for Stremio Desktop on this Mac.
# HOST=127.0.0.1
# PORT=7331
# PUBLIC_URL=http://127.0.0.1:7331

# shortlist (default) or all
# STREAM_LIST=shortlist

# Set to 1 to allow visitors on PUBLIC_URL to create independent installations.
# PUBLIC_SIGNUP=0
